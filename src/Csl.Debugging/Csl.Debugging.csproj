<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shader debugging for a Stride game: CslDebug.Register(game) in Program.cs, then Ctrl+click a pixel
       to run it on the CPU (Csl.Cpu) and step through its shaders, and C# shaders reloaded on save. It
       carries the conversion (Csl.Generators) and Roslyn: a development dependency, not one to ship. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Csl.Debugging</RootNamespace>
    <AssemblyName>Csl.Debugging</AssemblyName>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <StrideContainsAssetTypes>false</StrideContainsAssetTypes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stride.Engine" Version="$(StrideVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Silk.NET.SPIRV" Version="2.23.0" />
    <PackageReference Include="Silk.NET.SPIRV.Cross" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Csl.Types/Csl.Types.csproj" />
    <ProjectReference Include="../Csl.Engine/Csl.Engine.csproj" />
    <ProjectReference Include="../Csl.Runtime/Csl.Runtime.csproj" />
    <ProjectReference Include="../Csl.Generators/Csl.Generators.csproj" />
  </ItemGroup>

</Project>
