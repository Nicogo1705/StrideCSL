  </ItemGroup>
  <ItemGroup>
    <!-- StrideCSL: shaders written in C# (Shaders/), and the CPU debugging CslDebug.Register brings. -->
    <ProjectReference Include="..\..\..\src\Csl.Types\Csl.Types.csproj" />
    <ProjectReference Include="..\..\..\src\Csl.Engine\Csl.Engine.csproj" />
    <ProjectReference Include="..\..\..\src\Csl.Runtime\Csl.Runtime.csproj" />
    <ProjectReference Include="..\..\..\src\Csl.Debugging\Csl.Debugging.csproj" />
    <ProjectReference Include="..\..\..\src\Csl.Generators\Csl.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
