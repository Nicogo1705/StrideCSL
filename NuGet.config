<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Local feed a Stride checkout auto-packs into when built; harmless when absent. -->
    <add key="stride-dev" value="%LOCALAPPDATA%\stride\nugetdev" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
