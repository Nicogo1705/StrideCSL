<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# shaders of Shaders/ in a window, redrawn from their C# on each save. "dotnet run". -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Csl.Demo</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stride.Engine" Version="$(StrideVersion)" />
    <!-- The engine's own shaders are assets: the asset compiler builds them into the game's database,
         which the effect compiler reads at run time. -->
    <PackageReference Include="Stride.AssetCompiler" Version="$(StrideVersion)" IncludeAssets="build;buildTransitive" />
    <!-- The live compilation runs the generator on Roslyn in the app; C# 14 for Csl.Types' extension members. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Csl.Runtime/Csl.Runtime.csproj" />
    <ProjectReference Include="../../src/Csl.Types/Csl.Types.csproj" />
    <ProjectReference Include="../../src/Csl.Engine/Csl.Engine.csproj" />
    <!-- The generator, applied to Shaders/ at build time, and referenced as a library to do the same
         while the app runs. -->
    <ProjectReference Include="../../src/Csl.Generators/Csl.Generators.csproj" />
    <ProjectReference Include="../../src/Csl.Debugging/Csl.Debugging.csproj" />
    <Analyzer Include="../../src/Csl.Generators/bin/$(Configuration)/netstandard2.0/Csl.Generators.dll" />
  </ItemGroup>

</Project>
