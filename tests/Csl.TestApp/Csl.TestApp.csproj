<Project Sdk="Microsoft.NET.Sdk">

  <!-- The shader test bench: converts the engine's shaders SDSL to C# to SDSL and checks them with
       the engine's own compiler, and runs the C# shaders on the GPU. "dotnet run help". -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Csl.TestApp</RootNamespace>
    <StrideAssetBuildManifest>false</StrideAssetBuildManifest>
    <StrideContainsAssetTypes>false</StrideContainsAssetTypes>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stride.Engine" Version="$(StrideVersion)" />
    <!-- Newer than the generator builds against: the conversion compiles C# 14 (extension members of Csl.Types). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Csl.Runtime/Csl.Runtime.csproj" />
    <ProjectReference Include="../../src/Csl.Types/Csl.Types.csproj" />
    <ProjectReference Include="../../src/Csl.Engine/Csl.Engine.csproj" />
    <ProjectReference Include="../../src/Csl.Generators/Csl.Generators.csproj" />
  </ItemGroup>

</Project>
